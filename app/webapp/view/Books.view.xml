<mvc:View
  controllerName="app.controller.Main"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc">
  <Page
    id="booksPage"
    title="Books"
    showNavButton="true"
    navButtonPress=".onNavBack"
    enableScrolling="true">
    <content>
      <List
        id="booksList"
        items="{view>/books}">
        <StandardListItem
          title="{view>title}"
          description="{view>genre}"
          info="{view>price}">
        </StandardListItem>
      </List>
    </content>
  </Page>
</mvc:View>
